# One default .gitignore for all Roost repos — deliberately over-ignoring;
# per-language variants are not wanted.

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Go
*.exe
*.test
*.prof

# Rust
target/

# Build output
dist/
build/
out/

# Editor droppings & OS
.DS_Store
*.swp
*.swo
*~
.idea/
.vscode/

# Local environment
.env
.env.*

# bl runtime state: the workon lock and .bl/ (activity log, run state)
.workon.lock
.bl/
